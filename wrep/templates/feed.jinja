{%- extends 'base.jinja' %}
{%- block content %}
<form>
    {%- for field, value in form.items() %}
    <div class="input">
        <input name="{{ field }}" placeholder="{{ field }}" value="{{ value|default('', true) }}">
    </div>
    {%- endfor %}
    <input type="submit">
    <button class="button form-reset">Reset</button>
</form>
<div>
    <ul>
        <li><a href="{{ permalinks.rss }}">RSS</a></li>
        <li><a href="{{ permalinks.atom }}">Atom</a></li>
    </ul>
</div>
{%- include 'reports/detail.jinja' %}
{%- endblock %}
{%- block scripts %}
<script src="/static/js/feed.js"></script>
{%- endblock %}