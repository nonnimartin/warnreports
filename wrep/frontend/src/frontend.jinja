<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
  <head>
      <meta charset="utf-8">
      <meta name="viewport" content="width=device-width, initial-scale=1">
      <title>WARN Reporter</title>
      <link href="/assets/css/bootstrap.min.css" rel="stylesheet">
